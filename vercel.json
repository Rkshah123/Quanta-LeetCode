{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://quanta-api-2i9a.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://quanta-api-2i9a.onrender.com/health"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}

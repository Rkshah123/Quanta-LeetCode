# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file — it is listed in .gitignore.

# --- Server -----------------------------------------------------------------
PORT=3000
# HOST=0.0.0.0
# Extra browser origins allowed to call the API (comma separated).
# CORS_ORIGINS=https://your-frontend.example.com
# Requests per minute per IP for /api/* (0 disables the limiter).
RATE_LIMIT_MAX=300
# Tighter per-IP budget for code execution and the assistant (0 disables).
# RUN_RATE_LIMIT_MAX=30
# How many code runs may compile at the same time.
# MAX_CONCURRENT_RUNS=4
# Proxy hops in front of the server (auto-enabled on Render, e.g. TRUST_PROXY=1).
# TRUST_PROXY=

# --- MySQL ------------------------------------------------------------------
# Quote values that contain characters such as # or $, otherwise dotenv
# treats everything after # as a comment and the password is truncated.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD="your-mysql-password"
DB_NAME=Quanta-Leetcode
DB_CONNECTION_LIMIT=10
DB_QUERY_TIMEOUT_MS=8000

# TLS for hosted MySQL (TiDB / Aiven / RDS / …). Leave empty for local MySQL.
# Point DB_SSL_CA at the provider's certificate bundle when it supplies one.
# DB_SSL=true
# DB_SSL_CA=./certs/provider-ca.pem

# --- Optional ---------------------------------------------------------------
# Cloud runner for languages this machine cannot compile (e.g. Java on a host
# with no JDK). The free public instance needs no key. JUDGE0_URL="" disables.
# JUDGE0_URL=https://ce.judge0.com
# JUDGE0_TOKEN=
# JUDGE0_TIMEOUT_MS=60000
# MAX_ASSISTANT_MESSAGE_LENGTH=1200
# COMPILE_TIMEOUT_MS=20000
# RUN_TIMEOUT_MS=5000
# MAX_CODE_LENGTH=100000
# MAX_STDIN_LENGTH=20000
